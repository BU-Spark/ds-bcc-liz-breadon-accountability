# Ignore Python compiled files
__pycache__/

# Ignore data files
*.csv
*.tsv
*.xlsx
*.xls
*.json

# Ignore temporary/system files
.DS_Store

# Ignore logs and other temporary files
*.log
*.tmp
*.bak
*.swp

# Ignore virtual environment
venv/
.env/

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore large model and checkpoint files
*.ckpt
*.h5
*.weights
*.pkl

# Ignore any large compressed files
*.zip
*.tar.gz
*.rar

# Ignore IDE and editor configurations
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
